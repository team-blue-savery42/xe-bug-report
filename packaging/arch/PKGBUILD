# SPDX-License-Identifier: MIT
# Maintainer: xe-bug-report contributors <savery42@users.noreply.github.com>
#
# Builds from the source tarball attached to each GitHub release. The release workflow
# (.github/workflows/release.yml) sets pkgver and the checksum, builds the pacman package from
# it and pushes it with .SRCINFO to the AUR.
pkgname=xe-bug-report
pkgver=0.1.0
pkgrel=1
pkgdesc='Standalone GPU diagnostic collector: writes a redacted zip bundle of logs, sysfs and tool output'
arch=('x86_64')
url='https://github.com/team-blue-savery42/xe-bug-report'
license=('MIT')
depends=('glibc' 'gcc-libs')
makedepends=('cargo')
# cargo already strips the release binary, so a -debug package would be empty.
options=('!debug')
optdepends=('pciutils: lspci device and link listings')
# The release version: makepkg spells a pre-release 1.0.0-rc.1 as pkgver 1.0.0_rc.1.
_version=${pkgver//_/-}
source=("$pkgname-$_version-source.tar.gz::$url/releases/download/v$_version/$pkgname-$_version-source.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname-$_version"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
    cd "$pkgname-$_version"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

check() {
    cd "$pkgname-$_version"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo test --frozen
}

package() {
    cd "$pkgname-$_version"
    install -Dm0755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
    install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm0644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
